---
const infoCards = [
  {
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
    label: 'Dirección',
    value: 'Vereda Payo, Útica, Cundinamarca, Colombia'
  },
  {
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
    label: 'Horario',
    value: 'Lunes a Domingo: 8:00 AM – 5:00 PM'
  },
  {
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>`,
    label: 'Cómo llegar',
    value: 'Vía Bogotá–Villavicencio, desvío a Útica'
  },
  {
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>`,
    label: 'Distancia',
    value: 'Aprox. 100 km desde Bogotá (2 horas)'
  }
]
---

<section id="contacto" class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16 items-start">
      <!-- Left: Info -->
      <div>
        <span class="section-tag reveal">UBICACIÓN</span>

        <h2
          class="font-heading font-black text-4xl sm:text-5xl text-primary-dark mt-4 mb-6 leading-tight reveal reveal-delay-1"
        >
          A solo 2 horas<br />de Bogotá
        </h2>

        <p class="text-gray-600 font-body leading-relaxed mb-10 reveal reveal-delay-2">
          Horse Payo está ubicado en <strong class="text-primary-dark"
            >Útica, Cundinamarca</strong
          >, un pequeño paraíso natural a tan solo 2 horas de Bogotá por la vía al Llano.
          Rodeado de montañas, ríos y cascadas, Útica es el destino perfecto para escapar de la
          rutina y sumergirte en la aventura.
        </p>

        <!-- Info cards -->
        <div class="grid sm:grid-cols-2 gap-4 mb-10">
          {
            infoCards.map((card, i) => (
              <div
                class={`bg-forest-50 rounded-xl p-4 border border-forest-100 reveal reveal-delay-${i + 1}`}
              >
                <div class="flex items-start gap-3">
                  <div class="w-9 h-9 rounded-lg bg-primary/10 flex items-center justify-center text-primary flex-shrink-0">
                    <Fragment set:html={card.icon} />
                  </div>
                  <div>
                    <p class="text-xs font-bold text-gray-400 uppercase tracking-wide mb-0.5">
                      {card.label}
                    </p>
                    <p class="text-sm font-semibold text-primary-dark">{card.value}</p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>

        <!-- CTA buttons -->
        <div class="flex flex-wrap gap-4 reveal reveal-delay-3">
          <a
            href="https://maps.app.goo.gl/cju9eqRj8kCbCEEi8"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"
              ></path>
            </svg>
            Ver en Google Maps
          </a>
          <a
            href="https://wa.me/573228837910?text=¿Cómo%20llego%20a%20Horse%20Payo%20desde%20Bogotá?"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"
              ></path>
            </svg>
            Pedir indicaciones
          </a>
        </div>
      </div>

      <!-- Right: Map embed -->
      <div class="reveal reveal-delay-2">
        <div
          class="rounded-2xl overflow-hidden shadow-xl border border-gray-100 h-[400px] lg:h-[500px]"
        >
          <iframe
            src="https://maps.google.com/maps?q=Utica+Cundinamarca+Colombia&t=&z=13&ie=UTF8&iwloc=&output=embed"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Mapa de Útica, Cundinamarca – Horse Payo"></iframe>
        </div>

        <!-- Distance chips -->
        <div class="flex flex-wrap gap-3 mt-4">
          <div
            class="flex items-center gap-2 bg-forest-50 border border-forest-100 rounded-full px-4 py-2 text-sm text-primary-dark font-semibold"
          >
            🚗 2h desde Bogotá
          </div>
          <div
            class="flex items-center gap-2 bg-forest-50 border border-forest-100 rounded-full px-4 py-2 text-sm text-primary-dark font-semibold"
          >
            📍 100 km aprox.
          </div>
          <div
            class="flex items-center gap-2 bg-forest-50 border border-forest-100 rounded-full px-4 py-2 text-sm text-primary-dark font-semibold"
          >
            🕗 8 AM – 5 PM
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
