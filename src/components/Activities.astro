---

<section id="actividades" class="py-24 bg-accent relative overflow-hidden" aria-labelledby="activities-heading">

  <!-- Decorative circles -->
  <div class="absolute top-0 right-0 w-64 h-64 rounded-full bg-accent-light/30 -translate-y-1/2 translate-x-1/3"></div>
  <div class="absolute bottom-0 left-0 w-48 h-48 rounded-full bg-primary/10 translate-y-1/3 -translate-x-1/4"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Header -->
    <div class="text-center mb-16">
      <span class="inline-block bg-white/30 text-primary-dark font-semibold text-xs tracking-widest uppercase px-4 py-1.5 rounded-full border border-primary-dark/20 reveal">
        ¿QUÉ HACER?
      </span>
      <h2 id="activities-heading" class="font-heading font-black text-4xl sm:text-5xl text-primary-dark mt-4 mb-4 reveal reveal-delay-1">
        Nuestras actividades
      </h2>
      <p class="text-primary-dark/70 max-w-xl mx-auto font-body reveal reveal-delay-2">
        Adrenalina pura en cada experiencia. Descubre todas las aventuras que te esperan en Horse Payo.
      </p>
    </div>

    <!-- Activities grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-6">
      {activities.map((activity, i) => {
        const Tag = activity.href ? 'a' : 'div'
        const extraProps = activity.href ? { href: activity.href } : {}
        return (
          <Tag
            {...extraProps}
            class={`flex flex-col items-center text-center group cursor-pointer reveal reveal-delay-${i + 1}`}
          >
            <!-- Icon circle -->
            <div class="w-24 h-24 rounded-full bg-white shadow-lg flex items-center justify-center mb-5 text-primary-dark group-hover:scale-110 group-hover:shadow-xl transition-all duration-300 group-hover:bg-primary-dark group-hover:text-white">
              <Fragment set:html={activity.icon} />
            </div>
            <!-- Name -->
            <h3 class="font-heading font-black text-primary-dark text-base mb-2">
              {activity.name}
            </h3>
            <!-- Description -->
            <p class="text-primary-dark/65 text-xs leading-relaxed max-w-[160px]">
              {activity.description}
            </p>
          </Tag>
        )
      })}
    </div>

    <!-- CTA -->
    <div class="text-center mt-16 reveal">
      <a
        href="https://wa.me/573228837910?text=Hola!%20Quiero%20saber%20más%20sobre%20las%20actividades%20de%20Horse%20Payo"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-primary-dark text-white font-bold px-8 py-4 rounded-full hover:bg-primary transition-all duration-300 hover:scale-105 shadow-xl"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/>
        </svg>
        Consultar por WhatsApp
      </a>
    </div>
  </div>
</section>
