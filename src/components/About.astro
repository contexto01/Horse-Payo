---
const features = [
  { icon: '🛡️', label: 'Guías certificados' },
  { icon: '⚙️', label: 'Equipos de seguridad premium' },
  { icon: '🌿', label: 'Compromiso ambiental' },
  { icon: '💛', label: 'Experiencias personalizadas' },
];

const stats = [
  { value: '10+', label: 'Años de experiencia' },
  { value: '15+', label: 'Actividades diferentes' },
  { value: '100%', label: 'Satisfacción garantizada' },
  { value: '5000+', label: 'Aventureros atendidos' },
];
---

<section id="nosotros" class="py-24 bg-forest-50 overflow-hidden" aria-labelledby="about-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header tag -->
    <div class="mb-16">
      <span class="section-tag reveal">QUIÉNES SOMOS</span>
    </div>

    <div class="grid lg:grid-cols-2 gap-16 items-center">

      <!-- Left: Text content -->
      <div>
        <h2 id="about-heading" class="font-heading font-black text-4xl sm:text-5xl text-primary-dark leading-tight mb-6 reveal">
          Expertos en aventura y ecoturismo
        </h2>

        <div class="space-y-4 text-gray-600 font-body leading-relaxed mb-8">
          <p class="reveal reveal-delay-1">
            Horse Payo es más que una agencia de ecoturismo. Somos apasionados por la naturaleza y la adrenalina, ubicados en el corazón de Útica, Cundinamarca. Con más de una década de experiencia, ofrecemos experiencias seguras y memorables que conectan a nuestros visitantes con la magia de la naturaleza colombiana.
          </p>
          <p class="reveal reveal-delay-2">
            Nuestro equipo de guías certificados, equipos de seguridad de primera calidad y compromiso con el medio ambiente hacen de cada visita una aventura inolvidable. Desde canopy extremo hasta cabalgatas ecológicas, tenemos el plan perfecto para ti.
          </p>
        </div>

        <!-- Features grid -->
        <div class="grid grid-cols-2 gap-3 mb-8">
          {features.map((f, i) => (
            <div class={`flex items-center gap-3 bg-white rounded-xl p-4 shadow-sm border border-forest-100 reveal reveal-delay-${i + 1}`}>
              <span class="text-xl">{f.icon}</span>
              <span class="text-sm font-semibold text-primary-dark">{f.label}</span>
            </div>
          ))}
        </div>

        <a
          href="#planes"
          onclick="fbq('track', 'ViewContent', {content_name: 'Ver Planes About', content_category: 'navigation'})"
          class="btn-primary reveal reveal-delay-3"
        >
          Ver nuestros planes
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>

      <!-- Right: Image + price badge -->
      <div class="relative reveal reveal-delay-2">
        <!-- Main image -->
        <div class="relative rounded-3xl overflow-hidden shadow-2xl">
          <picture>
            <source srcset="/about-us.webp" type="image/webp" />
            <source srcset="/about-us.jpg" type="image/jpeg" />
            <img
              src="/about-us.jpg"
              alt="Equipo de guías certificados de Horse Payo en Útica, Cundinamarca"
              class="w-full h-[520px] object-cover object-center hover:scale-105 transition-transform duration-700"
              width="800"
              height="520"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <!-- Decorative corner -->
          <div class="absolute top-4 right-4 bg-primary-dark/80 backdrop-blur text-white text-xs font-bold px-3 py-1.5 rounded-full">
            🏆 10+ años
          </div>
        </div>

        <!-- Price badge -->
        <div class="absolute -bottom-6 -left-6 bg-accent text-primary-dark rounded-2xl p-5 shadow-2xl">
          <p class="text-xs font-semibold uppercase tracking-widest mb-0.5">Desde</p>
          <p class="text-3xl font-black leading-none">$93.000</p>
          <p class="text-xs font-medium mt-0.5">por persona</p>
        </div>

        <!-- Decorative element -->
        <div class="absolute -top-6 -right-6 w-32 h-32 rounded-full bg-primary/10 -z-10"></div>
        <div class="absolute -bottom-10 right-10 w-20 h-20 rounded-full bg-accent/20 -z-10"></div>
      </div>
    </div>

    <!-- Stats bar -->
    <div class="mt-24 grid grid-cols-2 md:grid-cols-4 gap-6">
      {stats.map((stat, i) => (
        <div class={`text-center reveal reveal-delay-${i + 1}`}>
          <div class="font-display text-6xl text-primary-dark leading-none mb-2">{stat.value}</div>
          <div class="text-gray-500 text-sm font-medium">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
