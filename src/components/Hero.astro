---
// Hero Section – Vive la Aventura Extrema
---

<section id="inicio" class="relative h-screen min-h-[680px] flex items-center overflow-hidden" aria-label="Hero – Horse Payo">
  <!-- Background Image -->
  <div class="absolute inset-0 z-0">
    <picture>
      <source srcset="/hero.webp" type="image/webp" />
      <source srcset="/hero.jpg" type="image/jpeg" />
      <img
        src="/hero.jpg"
        alt="Horse Payo – Aventura y ecoturismo en Útica, Cundinamarca"
        class="w-full h-full object-cover object-center"
        width="1600"
        height="900"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <!-- Overlay gradient -->
    <div class="absolute inset-0 hero-overlay"></div>
    <!-- Bottom fade -->
    <div
      class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-black/40 to-transparent"
    >
    </div>
  </div>

  <!-- Animated particles / bokeh circles -->
  <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none">
    <div
      class="absolute top-1/4 right-1/4 w-64 h-64 rounded-full bg-accent/10 blur-3xl animate-pulse"
    >
    </div>
    <div
      class="absolute bottom-1/3 right-1/3 w-48 h-48 rounded-full bg-primary-light/10 blur-3xl animate-pulse"
      style="animation-delay:1s"
    >
    </div>
  </div>

  <!-- Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full pt-20">
    <div class="max-w-2xl">
      <!-- Location badge -->
      <div
        class="inline-flex items-center gap-2 bg-white/15 backdrop-blur-sm border border-white/25 text-white text-sm font-medium px-4 py-2 rounded-full mb-6 animate-fade-in"
      >
        <svg class="w-4 h-4 text-accent flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
          <path
            d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
          ></path>
        </svg>
        Útica, Cundinamarca · Colombia
      </div>

      <!-- Main heading -->
      <h1 class="text-white leading-none mb-4 text-shadow">
        <span
          class="block font-display text-7xl sm:text-8xl lg:text-9xl tracking-wider animate-fade-up"
          style="animation-delay:0.1s">VIVE LA</span
        >
        <span
          class="block font-display text-7xl sm:text-8xl lg:text-9xl tracking-wider text-accent animate-fade-up"
          style="animation-delay:0.2s">AVENTURA</span
        >
        <span
          class="block font-display text-7xl sm:text-8xl lg:text-9xl tracking-wider animate-fade-up"
          style="animation-delay:0.3s">EXTREMA</span
        >
      </h1>

      <!-- Subtitle -->
      <p
        class="text-white/85 text-lg sm:text-xl font-body font-light max-w-md mb-10 text-shadow-sm animate-fade-up"
        style="animation-delay:0.4s"
      >
        Ecoturismo, adrenalina y naturaleza en un solo lugar
      </p>

      <!-- CTA buttons -->
      <div class="flex flex-wrap gap-4 animate-fade-up" style="animation-delay:0.5s">
        <a
          href="https://wa.me/573228837910?text=Hola!%20Quiero%20reservar%20un%20plan%20en%20Horse%20Payo"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary text-base"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"
            ></path>
          </svg>
          Reserva Ahora
        </a>
        <a href="#planes" class="btn-outline text-base"> Ver Planes </a>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div
    class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-2 text-white/60 animate-bounce-slow"
  >
    <span class="text-xs tracking-widest uppercase font-medium">Explorar</span>
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"
      ></path>
    </svg>
  </div>
</section>
