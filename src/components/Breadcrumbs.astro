---
export interface BreadcrumbItem {
  label: string
  href?: string
}

export interface Props {
  items: BreadcrumbItem[]
}

const { items } = Astro.props

const lastItem = items[items.length - 1]?.label || ''
const currentUrl = Astro.url.pathname
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Inicio',
      item: 'https://deportesextremoshorsepayo.com/'
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: lastItem,
      item: `https://deportesextremoshorsepayo.com${currentUrl}`
    }
  ]
}
---

<nav aria-label="Breadcrumb" class="bg-primary-dark/95 border-b border-primary">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 pt-16">
    <ol class="flex items-center gap-2 text-sm" itemscope itemtype="https://schema.org/BreadcrumbList">
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a
          href="/"
          itemprop="item"
          class="text-gray-400 hover:text-primary transition-colors flex items-center gap-1"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
          </svg>
          <span itemprop="name">Inicio</span>
        </a>
        <meta itemprop="position" content="1" />
      </li>

      {items.map((item, i) => {
        const position = i + 2
        return (
          <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
            <svg class="w-3 h-3 text-gray-300 inline mx-1" fill="currentColor" viewBox="0 0 24 24">
              <path d="M9 5l7 7-7 7"/>
            </svg>
            {item.href ? (
              <a
                href={item.href}
                itemprop="item"
                class="text-gray-400 hover:text-primary transition-colors ml-1"
              >
                <span itemprop="name">{item.label}</span>
              </a>
            ) : (
              <span itemprop="name" class="text-white font-semibold ml-1" aria-current="page">
                {item.label}
              </span>
            )}
            <meta itemprop="position" content={String(position)} />
          </li>
        )
      })}
    </ol>
  </div>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)}>
