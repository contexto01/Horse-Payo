---
const navLinks = [
  { label: 'Inicio', href: '/#inicio' },
  { label: 'Planes', href: '/#planes' },
  { label: 'Actividades', href: '/#actividades' },
  { label: 'Testimonios', href: '/#testimonios' },
  { label: 'Contacto', href: '/#contacto' }
]

const logoHref = Astro.url.pathname === '/' ? '/#inicio' : '/'
---

<nav
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 py-4"
  aria-label="Navegación principal"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between">
      <!-- Logo -->
      <a href={logoHref} class="flex items-center gap-2.5 group">
        <picture>
          <source srcset="/hp-logo.webp" type="image/webp" />
          <img
            src="/Logo.jpg"
            alt="Horse Payo"
            class="w-9 h-9 rounded-full object-cover shadow-md group-hover:scale-110 transition-transform duration-300"
            width="160"
            height="160"
            decoding="async"
          />
        </picture>
        <span class="font-heading font-bold text-white text-lg tracking-wide drop-shadow-md"
          >Horse Payo</span
        >
      </a>

      <!-- Desktop Nav -->
      <div class="hidden md:flex items-center gap-8">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              onclick={`fbq('track', 'ViewContent', {content_name: '${link.label}', content_category: 'navigation'})`}
              class="text-white/90 hover:text-accent font-medium text-sm tracking-wide transition-colors duration-200 relative group"
            >
              {link.label}
              <span class="absolute -bottom-0.5 left-0 w-0 h-0.5 bg-accent group-hover:w-full transition-all duration-300 rounded-full" />
            </a>
          ))
        }
        <a
          href="https://wa.me/573228837910?text=Hola!%20Quiero%20reservar%20un%20plan%20en%20Horse%20Payo"
          target="_blank"
          rel="noopener noreferrer"
          onclick="fbq('track', 'InitiateCheckout', {content_name: 'Navbar Desktop', currency: 'COP'})"
          class="bg-accent text-primary-dark font-bold text-sm px-5 py-2.5 rounded-full hover:bg-accent-dark transition-all duration-300 hover:scale-105 shadow-lg"
        >
          Reservar
        </a>
      </div>

      <!-- Mobile menu button -->
      <button id="mobile-menu-btn" class="md:hidden text-white p-2" aria-label="Menú">
        <svg
          id="menu-icon"
          class="w-6 h-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg
          id="close-icon"
          class="w-6 h-6 hidden"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <div
      id="mobile-menu"
      class="hidden md:hidden mt-4 bg-primary-dark/95 backdrop-blur rounded-2xl p-4 border border-white/10"
    >
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            onclick={`fbq('track', 'ViewContent', {content_name: '${link.label} Mobile', content_category: 'navigation'})`}
            class="block text-white/90 hover:text-accent font-medium py-3 px-4 rounded-xl hover:bg-white/10 transition-colors duration-200"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="https://wa.me/573228837910"
        target="_blank"
        rel="noopener noreferrer"
        onclick="fbq('track', 'InitiateCheckout', {content_name: 'Navbar Mobile', currency: 'COP'})"
        class="mt-2 w-full bg-accent text-primary-dark font-bold text-sm px-5 py-3 rounded-xl hover:bg-accent-dark transition-colors text-center block"
      >
        Reservar ahora
      </a>
    </div>
  </div>
</nav>

<script>
  const navbar = document.getElementById('navbar')
  const mobileBtn = document.getElementById('mobile-menu-btn')
  const mobileMenu = document.getElementById('mobile-menu')
  const menuIcon = document.getElementById('menu-icon')
  const closeIcon = document.getElementById('close-icon')

  // Scroll effect
  window.addEventListener('scroll', () => {
    if (window.scrollY > 60) {
      navbar?.classList.add('bg-primary-dark/95', 'backdrop-blur-md', 'shadow-xl', 'py-2')
      navbar?.classList.remove('py-4')
    } else {
      navbar?.classList.remove('bg-primary-dark/95', 'backdrop-blur-md', 'shadow-xl', 'py-2')
      navbar?.classList.add('py-4')
    }
  })

  // Mobile toggle
  mobileBtn?.addEventListener('click', () => {
    fbq('track', 'ViewContent', {content_name: 'Mobile Menu Toggle', content_category: 'navigation'})
    const isOpen = !mobileMenu?.classList.contains('hidden')
    mobileMenu?.classList.toggle('hidden')
    menuIcon?.classList.toggle('hidden', !isOpen)
    closeIcon?.classList.toggle('hidden', isOpen)
  })

  // Close mobile menu on link click
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden')
      menuIcon?.classList.remove('hidden')
      closeIcon?.classList.add('hidden')
    })
  })
</script>
