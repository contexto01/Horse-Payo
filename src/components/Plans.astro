---
const plans = [
  {
    id: 'pasadia-6',
    name: 'Plan Pasadía 6',
    subtitle: 'Cabalgata + Circuito Aéreo',
    image: '/plan-cabalgata',
    activities: [
      'Cabalgata ecológica (30-40 min)',
      'Vuelo 120m',
      'Puente tibetano',
      'Puente Himalaya',
      'Puente Indiana Jones',
      'Salto al vacío'
    ],
    benefits: ['Almuerzo incluido', 'Piscina natural', 'Parqueadero', 'Seguro de accidentes', 'Guía certificado'],
    pricePerPerson: '$190.000',
    priceFor2: '$380.000',
    highlight: false,
    badge: null,
  },
  {
    id: 'pasadia-2',
    name: 'Plan Pasadía 2',
    subtitle: 'Cuatrimoto + Cabalgata + Circuito',
    image: '/plan-cuatrimoto',
    activities: [
      'Cuatrimotos 4km (por pareja)',
      'Cabalgata ecológica (30-40 min)',
      'Circuito aéreo 5 estaciones'
    ],
    benefits: ['Almuerzo incluido', 'Piscina natural', 'Parqueadero', 'Seguro de accidentes', 'Equipo completo'],
    pricePerPerson: '$230.000',
    priceFor2: '$460.000',
    highlight: false,
    badge: null,
  },
  {
    id: 'pasadia-4',
    name: 'Plan Pasadía 4',
    subtitle: 'Cuatrimoto + Rafting + Cabalgata',
    image: '/plan-rafting',
    activities: [
      'Cuatrimotos 4km (por pareja)',
      'Minitren artesanal 6-7km',
      'Descenso río Negro en balsa',
      'Cabalgata ecológica (30-40 min)'
    ],
    benefits: ['Almuerzo incluido', 'Piscina natural', 'Parqueadero', 'Seguro de accidentes', 'Guía certificado'],
    pricePerPerson: '$290.000',
    priceFor2: '$580.000',
    highlight: true,
    badge: '⭐ MÁS POPULAR',
  },
  {
    id: 'pasadia-5',
    name: 'Plan Pasadía 5',
    subtitle: 'Aventura Total (4 actividades)',
    image: '/plan-completa',
    activities: [
      'Cuatrimotos 4km (por pareja)',
      'Cabalgata ecológica (30-40 min)',
      'Minitren + Descenso río Negro',
      'Circuito aéreo 5 estaciones'
    ],
    benefits: ['Almuerzo incluido', 'Piscina natural', 'Parqueadero', 'Seguro de accidentes', 'Equipo premium', 'Fotos incluidas'],
    pricePerPerson: '$350.000',
    priceFor2: '$700.000',
    highlight: false,
    badge: null,
  },
];
---

<section id="planes" class="py-24 bg-white" aria-labelledby="plans-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="text-center mb-16">
      <span class="section-tag reveal">PLANES DE AVENTURA</span>
      <h2 id="plans-heading" class="font-heading font-black text-4xl sm:text-5xl text-primary-dark mt-4 mb-4 reveal reveal-delay-1">
        Elige tu aventura
      </h2>
      <p class="text-gray-500 max-w-xl mx-auto font-body reveal reveal-delay-2">
        Planes diseñados para cada nivel de adrenalina. Desde pasadías románticos hasta aventuras completas en grupo.
      </p>
    </div>

    <!-- Plans grid -->
    <div class="grid md:grid-cols-2 gap-8">
      {plans.map((plan, i) => (
        <div class={`card-plan reveal reveal-delay-${(i % 4) + 1} ${plan.highlight ? 'ring-2 ring-accent shadow-accent/20' : ''}`}>

          <!-- Image header -->
          <div class="relative h-52 overflow-hidden">
            <picture>
              <source srcset={`${plan.image}.webp`} type="image/webp" />
              <source srcset={`${plan.image}.jpg`} type="image/jpeg" />
              <img
                src={`${plan.image}.jpg`}
                alt={`${plan.name} – ${plan.subtitle} en Horse Payo, Útica`}
                class="w-full h-full object-cover hover:scale-110 transition-transform duration-700"
                width="800"
                height="520"
                loading="lazy"
                decoding="async"
              />
            </picture>
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"></div>

            <!-- Plan name overlay -->
            <div class="absolute bottom-4 left-4">
              <h3 class="text-white font-heading font-black text-xl">{plan.name}</h3>
              <p class="text-white/75 text-sm">{plan.subtitle}</p>
            </div>

            {plan.badge && (
              <div class="absolute top-4 right-4 bg-accent text-primary-dark text-xs font-black px-3 py-1.5 rounded-full tracking-wide">
                {plan.badge}
              </div>
            )}
          </div>

          <!-- Plan body -->
          <div class="p-6">

            <!-- Activities -->
            <div class="mb-5">
              <h4 class="font-heading font-bold text-sm text-primary-dark uppercase tracking-wide mb-3">
                Actividades incluidas:
              </h4>
              <div class="flex flex-wrap gap-2">
                {plan.activities.map((act) => (
                  <span class="badge-activity">
                    <svg class="w-3 h-3 text-primary" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    {act}
                  </span>
                ))}
              </div>
            </div>

            <!-- Benefits -->
            <div class="mb-6 bg-forest-50 rounded-xl p-4">
              <h4 class="font-heading font-bold text-sm text-primary-dark uppercase tracking-wide mb-3">
                Beneficios:
              </h4>
              <ul class="space-y-1.5">
                {plan.benefits.map((b) => (
                  <li class="flex items-center gap-2 text-sm text-gray-600">
                    <svg class="w-4 h-4 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    {b}
                  </li>
                ))}
              </ul>
            </div>

            <!-- Price + CTA -->
            <div class="flex items-end justify-between">
              <div>
                <p class="text-xs text-gray-400 mb-0.5">desde {plan.pricePerPerson} por persona</p>
                <p class="text-3xl font-black text-primary-dark">desde {plan.priceFor2}</p>
                <p class="text-xs text-gray-400 mt-0.5">para 2 personas</p>
              </div>
            </div>

            <a
              href={`https://wa.me/573228837910?text=Hola!%20Quiero%20reservar%20el%20${encodeURIComponent(plan.name)}%20en%20Horse%20Payo`}
              target="_blank"
              rel="noopener noreferrer"
              onclick={`fbq('track', 'Contact', {content_name: '${plan.name}', content_ids: ['${plan.id}'], content_category: 'contact', currency: 'COP', value: ${parseInt(plan.pricePerPerson.replace(/[\$.,]/g, ''))}}})`}
              class={`mt-5 w-full flex items-center justify-center gap-2 font-bold py-3.5 px-6 rounded-xl transition-all duration-300 hover:scale-[1.02] active:scale-95 ${
                plan.highlight
                  ? 'bg-accent text-primary-dark hover:bg-accent-dark'
                  : 'bg-primary-dark text-white hover:bg-primary'
              }`}
            >
              Reservar este Plan
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA bottom -->
    <div class="text-center mt-12 reveal">
      <p class="text-gray-500 text-sm mb-4">¿Tienes un grupo grande o quieres un plan personalizado?</p>
      <a
        href="https://wa.me/573228837910?text=Hola!%20Quiero%20un%20plan%20personalizado%20en%20Horse%20Payo"
        target="_blank"
        rel="noopener noreferrer"
        onclick="fbq('track', 'Contact', {content_name: 'Planes Grupales', content_category: 'contact'})"
        class="inline-flex items-center gap-2 text-primary font-semibold hover:text-primary-dark transition-colors border-b-2 border-primary/30 hover:border-primary pb-0.5"
      >
        Contáctanos para planes grupales
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>
