---

<footer class="bg-gray-900 text-white" role="contentinfo">
  <!-- Main footer -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- Brand column -->
      <div class="lg:col-span-1">
        <!-- Logo -->
        <div class="flex items-center gap-2.5 mb-4">
          <picture>
            <source srcset="/hp-logo.webp" type="image/webp" />
            <img
              src="/Logo.jpg"
              alt="Horse Payo"
              class="w-9 h-9 rounded-full object-cover shadow-md"
              width="160"
              height="160"
              decoding="async"
            />
          </picture>
          <span class="font-heading font-bold text-white text-lg tracking-wide"
            >Horse Payo</span
          >
        </div>
        <p class="text-gray-400 text-sm leading-relaxed mb-6">
          Tu próxima aventura comienza aquí. Ecoturismo y deportes extremos en Útica,
          Cundinamarca.
        </p>
        <!-- Social links -->
        <div class="flex gap-3">
          {
            socials.map((s) => (
              <a
                href={s.href}
                aria-label={s.name}
                class="w-9 h-9 rounded-full bg-white/10 hover:bg-accent hover:text-primary-dark text-gray-400 flex items-center justify-center transition-all duration-200 hover:scale-110"
              >
                <Fragment set:html={s.icon} />
              </a>
            ))
          }
        </div>
      </div>

      <!-- Contact column -->
      <div>
        <h4 class="font-heading font-bold text-white text-sm uppercase tracking-widest mb-5">
          Contacto
        </h4>
        <ul class="space-y-3 text-sm text-gray-400">
          <li class="flex items-center gap-3 hover:text-accent transition-colors">
            <svg
              class="w-4 h-4 text-accent flex-shrink-0"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"
              ></path>
            </svg>
            <a href="https://wa.me/573228837910" target="_blank" rel="noopener noreferrer"
              >+57 300 123 4567</a
            >
          </li>
          <li class="flex items-center gap-3">
            <svg
              class="w-4 h-4 text-accent flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              ></path>
            </svg>
            <a href="mailto:info@horsepayo.com" class="hover:text-accent transition-colors"
              >info@horsepayo.com</a
            >
          </li>
          <li class="flex items-start gap-3">
            <svg
              class="w-4 h-4 text-accent flex-shrink-0 mt-0.5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              ></path>
            </svg>
            <span>Vereda Payo, Útica, Cundinamarca</span>
          </li>
          <li class="flex items-center gap-3">
            <svg
              class="w-4 h-4 text-accent flex-shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span>Lun – Dom: 8:00 AM – 5:00 PM</span>
          </li>
        </ul>
      </div>

      <!-- Navigation column -->
      <div>
        <h4 class="font-heading font-bold text-white text-sm uppercase tracking-widest mb-5">
          Navegación
        </h4>
        <ul class="space-y-3">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-gray-400 hover:text-accent text-sm transition-colors duration-200 flex items-center gap-2 group"
                >
                  <span class="w-0 h-0.5 bg-accent group-hover:w-3 transition-all duration-300 rounded-full" />
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Info + Newsletter column -->
      <div>
        <h4 class="font-heading font-bold text-white text-sm uppercase tracking-widest mb-5">
          Información
        </h4>
        <ul class="space-y-3 mb-8">
          {
            infoLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-gray-400 hover:text-accent text-sm transition-colors duration-200 flex items-center gap-2 group"
                >
                  <span class="w-0 h-0.5 bg-accent group-hover:w-3 transition-all duration-300 rounded-full" />
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>

        <!-- Newsletter -->
        <div>
          <h5 class="font-heading font-bold text-white text-xs uppercase tracking-widest mb-2">
            Mantente informado
          </h5>
          <p class="text-gray-400 text-xs mb-3">
            Recibe ofertas exclusivas y novedades sobre nuevas actividades.
          </p>
          <div class="flex gap-2">
            <input
              type="email"
              placeholder="Tu correo electrónico"
              class="flex-1 bg-white/10 border border-white/20 text-white placeholder-gray-500 text-xs px-3 py-2.5 rounded-lg focus:outline-none focus:border-accent/60 transition-colors"
            />
            <button
              class="bg-accent text-primary-dark font-bold text-xs px-4 py-2.5 rounded-lg hover:bg-accent-dark transition-colors whitespace-nowrap"
            >
              Suscribirse
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/10">
    <div
      class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 flex flex-col sm:flex-row items-center justify-between gap-3"
    >
      <p class="text-gray-500 text-xs">
        © {new Date().getFullYear()} Horse Payo. Todos los derechos reservados.
      </p>
      <p class="text-gray-500 text-xs">Hecho con 💛 en Colombia · Útica, Cundinamarca</p>
    </div>
  </div>
</footer>
