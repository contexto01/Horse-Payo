---
import Layout from '../layouts/Layout.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import Navbar from '../components/Navbar.astro'
import FormContacto from '../components/FormContacto.astro'
import Footer from '../components/Footer.astro'
import WhatsAppFloat from '../components/WhatsAppFloat.astro'
---

<Layout
  title="Rafting en Útica Cundinamarca – Rápidos y adrenalina | Horse Payo"
  description="Rafting en Útica, Cundinamarca. Navega los rápidos del río con guías expertos. Equipo de seguridad profesional. A solo 2 horas de Bogotá. Desde $93.000 por persona."
  canonical="https://deportesextremoshorsepayo.com/rafting-utica/"
  ogImage="https://deportesextremoshorsepayo.com/plan-rafting.jpg"
>
  <Navbar />
  <Breadcrumbs items={[{ label: 'Rafting en Útica' }]} />

  <main>
    <!-- Hero -->
    <section class="relative h-[70vh] min-h-[500px] flex items-center overflow-hidden pt-20 lg:pt-24">
      <div class="absolute inset-0 z-0">
        <picture>
          <source srcset="/plan-rafting.webp" type="image/webp" />
          <source srcset="/plan-rafting.jpg" type="image/jpeg" />
          <img src="/plan-rafting.jpg" alt="Rafting en Útica – Horse Payo" class="w-full h-full object-cover object-center" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
        </picture>
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-transparent"></div>
      </div>
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 bg-accent/90 text-primary-dark text-sm font-bold px-4 py-2 rounded-full mb-6">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
            Útica, Cundinamarca
          </div>
          <h1 class="text-white font-heading font-black text-5xl sm:text-6xl lg:text-7xl leading-tight mb-6">
            Rafting en <span class="text-accent">Útica</span>
          </h1>
          <p class="text-white/85 text-lg sm:text-xl font-body max-w-2xl mb-8 leading-relaxed">
            🌊 ¡Navega los rápidos más emocionantes de Cundinamarca! Una aventura extrema e inolvidable que incluye el descenso en balsa y un divertido recorrido en minitren. Todo liderado por expertos certificados a solo 2 horas de Bogotá. 🚣‍♂️🚂✨
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="https://wa.me/573228837910?text=Hola!%20Quiero%20reservar%20rafting%20en%20%C3%9Atica%20con%20Horse%20Payo" target="_blank" rel="noopener noreferrer" class="bg-accent text-primary-dark font-bold px-8 py-4 rounded-full hover:bg-accent-dark transition-all duration-300 hover:scale-105 shadow-xl text-base inline-flex items-center gap-3">
              📲 Reservar mi Cupo en el Río
            </a>
            <a href="#info-rafting" class="border-2 border-white text-white font-semibold px-8 py-4 rounded-full hover:bg-white hover:text-primary-dark transition-all duration-300 inline-flex items-center gap-2">
              Más información
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Info section -->
    <section id="info-rafting" class="py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <span class="section-tag reveal">RAFTING</span>
            <h2 class="font-heading font-black text-4xl sm:text-5xl text-primary-dark mt-4 mb-6 leading-tight reveal reveal-delay-1">
              La mejor experiencia de <span class="text-primary">rafting</span> cerca de Bogotá
            </h2>
            <div class="space-y-4 text-gray-600 font-body leading-relaxed reveal reveal-delay-2">
              <p>
                El Rafting en Útica con Horse Payo es la combinación perfecta de adrenalina pura, naturaleza y trabajo en equipo. Nuestro tour te ofrece una experiencia completa en el río:
              </p>
              <ul class="space-y-3">
                <li class="flex items-start gap-3">
                  <span class="text-lg flex-shrink-0">🚣‍♂️</span>
                  <span><strong>Descenso en Balsa Extremo:</strong> Domina los rápidos con la máxima seguridad.</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-lg flex-shrink-0">🚂</span>
                  <span><strong>Recorrido en Minitren:</strong> Un trayecto artesanal único e increíble por la región.</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-lg flex-shrink-0">🦺</span>
                  <span><strong>Equipamiento Profesional:</strong> Balsas autovaciables, chalecos de alta flotabilidad, cascos y remos técnicos.</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-lg flex-shrink-0">🗺️</span>
                  <span><strong>Guías Certificados:</strong> Instructores expertos en rescate fluvial y primeros auxilios.</span>
                </li>
              </ul>
              <p class="mt-4 text-primary-dark font-semibold">
                ¡Apto para todos los niveles de aventura! 🏞️🔥
              </p>
            </div>
            <div class="flex flex-wrap gap-3 mt-8 reveal reveal-delay-3">
              <span class="badge-activity">👮‍♂️ Guías de Río Certificados</span>
              <span class="badge-activity">🚣‍♂️ Balsas e Infraestructura Premium</span>
              <span class="badge-activity">🏥 Seguro de Asistencia Médica</span>
              <span class="badge-activity">🌊 Rápidos Nivel Seguro y Emocionante</span>
            </div>
          </div>
          <div class="reveal reveal-delay-2">
            <div class="rounded-3xl overflow-hidden shadow-2xl relative">
              <picture>
                <source srcset="/plan-rafting.webp" type="image/webp" />
                <source srcset="/plan-rafting.jpg" type="image/jpeg" />
                <img src="/plan-rafting.jpg" alt="Rafting en los rápidos de Útica, Cundinamarca" class="w-full h-[500px] object-cover object-center" width="800" height="500" loading="lazy" decoding="async" />
              </picture>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Plans section -->
    <section class="py-24 bg-forest-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-14">
          <h2 class="font-heading font-black text-4xl sm:text-5xl text-primary-dark mb-4 reveal">
            Elige tu plan de <span class="text-primary">rafting</span>
          </h2>
          <p class="text-gray-500 max-w-2xl mx-auto font-body reveal reveal-delay-1">
            Todos nuestros planes incluyen equipo profesional, guías certificados y seguro de asistencia médica. Precios por persona.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-6 lg:gap-8 max-w-6xl mx-auto">

          <!-- Card 1: Pasadía 1 -->
          <div class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden flex flex-col reveal">
            <div class="bg-primary-dark text-white text-center py-5 px-6">
              <h3 class="font-heading font-black text-xl">Plan Pasadía 1 🚣‍♂️</h3>
              <p class="text-white/75 text-sm mt-0.5">Río & Vuelo</p>
            </div>
            <div class="p-6 flex flex-col flex-1">
              <div class="text-center mb-6">
                <p class="text-gray-400 text-xs uppercase tracking-wide mb-1">Por persona</p>
                <p class="font-display text-5xl text-primary-dark leading-none">$225.000</p>
              </div>
              <ul class="space-y-3 mb-8 text-sm text-gray-600 flex-1">
                <li class="flex items-start gap-3">
                  <span class="text-base flex-shrink-0">🌊</span>
                  <span>Rafting Extremo <span class="text-gray-400">(Descenso en balsa + Minitren)</span></span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-base flex-shrink-0">🧗‍♂️</span>
                  <span>Circuito Extremo Completo <span class="text-gray-400">(Canopy, Puentes colgantes y Rapel)</span></span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-base flex-shrink-0">🍲</span>
                  <span>Almuerzo Tradicional Incluido</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-base flex-shrink-0">🎟️</span>
                  <span>Ingreso a las instalaciones y piscina</span>
                </li>
              </ul>
              <a href="https://wa.me/573228837910?text=Hola!%20Quiero%20reservar%20el%20Plan%20Pasad%C3%ADa%201%20(R%C3%ADo%20%26%20Vuelo)%20en%20Horse%20Payo" target="_blank" rel="noopener noreferrer" class="w-full bg-primary-dark text-white font-bold py-3.5 rounded-xl hover:bg-primary transition-all duration-300 hover:scale-[1.02] active:scale-95 inline-flex items-center justify-center gap-2">
                ⚡ Reservar Pasadía
              </a>
            </div>
          </div>

          <!-- Card 2: Pasadía 7 -->
          <div class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden flex flex-col reveal reveal-delay-1">
            <div class="bg-primary-dark text-white text-center py-5 px-6">
              <h3 class="font-heading font-black text-xl">Plan Pasadía 7 🧗‍♂️🌊</h3>
              <p class="text-white/75 text-sm mt-0.5">Desafío Acuático Natural</p>
            </div>
            <div class="p-6 flex flex-col flex-1">
              <div class="text-center mb-6">
                <p class="text-gray-400 text-xs uppercase tracking-wide mb-1">Por persona</p>
                <p class="font-display text-5xl text-primary-dark leading-none">$280.000</p>
              </div>
              <ul class="space-y-3 mb-8 text-sm text-gray-600 flex-1">
                <li class="flex items-start gap-3">
                  <span class="text-base flex-shrink-0">⛰️</span>
                  <span>Torrentismo Natural <span class="text-gray-400">(Canyoning, Trekking de montaña y Rapel en cascadas)</span></span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-base flex-shrink-0">🌊</span>
                  <span>Rafting Extremo <span class="text-gray-400">(Descenso en balsa + Minitren)</span></span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-base flex-shrink-0">🍲</span>
                  <span>Almuerzo Tradicional Incluido</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-base flex-shrink-0">🎟️</span>
                  <span>Ingreso a las instalaciones y piscina</span>
                </li>
              </ul>
              <a href="https://wa.me/573228837910?text=Hola!%20Quiero%20reservar%20el%20Plan%20Pasad%C3%ADa%207%20(Desaf%C3%ADo%20Acu%C3%A1tico%20Natural)%20en%20Horse%20Payo" target="_blank" rel="noopener noreferrer" class="w-full bg-primary-dark text-white font-bold py-3.5 rounded-xl hover:bg-primary transition-all duration-300 hover:scale-[1.02] active:scale-95 inline-flex items-center justify-center gap-2">
                ⚡ Reservar Pasadía
              </a>
            </div>
          </div>

          <!-- Card 3: Pasadía 5 (destacado) -->
          <div class="bg-white rounded-2xl shadow-lg overflow-hidden flex flex-col ring-2 ring-accent relative reveal reveal-delay-2">
            <div class="absolute top-3 right-3 z-10 bg-accent text-primary-dark text-xs font-black px-3 py-1.5 rounded-full tracking-wide shadow-lg">
              🏆 EL MÁS COMPLETO
            </div>
            <div class="bg-primary-dark text-white text-center py-5 px-6">
              <h3 class="font-heading font-black text-xl">Plan Pasadía 5 🏆</h3>
              <p class="text-white/75 text-sm mt-0.5">Mega Aventura Extrema</p>
            </div>
            <div class="p-6 flex flex-col flex-1">
              <div class="text-center mb-6">
                <p class="text-gray-400 text-xs uppercase tracking-wide mb-1">Por persona</p>
                <p class="font-display text-5xl text-primary-dark leading-none">$350.000</p>
              </div>
              <ul class="space-y-3 mb-8 text-sm text-gray-600 flex-1">
                <li class="flex items-start gap-3">
                  <span class="text-base flex-shrink-0">🚜</span>
                  <span>Ruta Guiada en Cuatrimoto Todo Terreno</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-base flex-shrink-0">🏇</span>
                  <span>Cabalgata Ecológica por Senderos</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-base flex-shrink-0">🌊</span>
                  <span>Rafting Extremo <span class="text-gray-400">(Descenso en balsa + Minitren)</span></span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-base flex-shrink-0">🧗‍♂️</span>
                  <span>Circuito Extremo Completo <span class="text-gray-400">(Canopy, Puentes y Rapel)</span></span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-base flex-shrink-0">🍲</span>
                  <span>Almuerzo Tradicional Incluido</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-base flex-shrink-0">🎟️</span>
                  <span>Ingreso a las instalaciones y piscina</span>
                </li>
              </ul>
              <a href="https://wa.me/573228837910?text=Hola!%20Quiero%20reservar%20el%20Plan%20Pasad%C3%ADa%205%20(Mega%20Aventura%20Extrema)%20en%20Horse%20Payo" target="_blank" rel="noopener noreferrer" class="w-full bg-accent text-primary-dark font-bold py-3.5 rounded-xl hover:bg-accent-dark transition-all duration-300 hover:scale-[1.02] active:scale-95 inline-flex items-center justify-center gap-2 shadow-md">
                ⚡ Reservar Pasadía
              </a>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20 bg-accent relative overflow-hidden">
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute -top-16 -right-16 w-72 h-72 rounded-full bg-accent-light/40"></div>
        <div class="absolute -bottom-20 -left-20 w-96 h-96 rounded-full bg-accent-dark/20"></div>
      </div>
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center relative z-10">
        <h2 class="font-heading font-black text-4xl sm:text-5xl lg:text-6xl text-primary-dark mb-4 reveal">
          ¿Listo para los rápidos?
        </h2>
        <p class="text-primary-dark/70 text-lg font-body max-w-xl mx-auto mb-10 reveal reveal-delay-1">
          Reserva tu experiencia de rafting hoy. Cupos limitados por salida.
        </p>
        <a href="https://wa.me/573228837910?text=Hola!%20Quiero%20reservar%20rafting%20en%20%C3%9Atica%20con%20Horse%20Payo" target="_blank" rel="noopener noreferrer" class="bg-primary-dark text-white font-bold px-10 py-4 rounded-full inline-flex items-center gap-3 hover:bg-primary transition-all duration-300 hover:scale-105 shadow-xl text-lg reveal reveal-delay-2">
          📲 Reservar mi Cupo en el Río
        </a>
      </div>
    </section>

    <FormContacto />
  </main>

  <Footer />
  <WhatsAppFloat />
</Layout>
