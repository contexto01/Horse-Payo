---
import Layout from '../layouts/Layout.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import Navbar from '../components/Navbar.astro'
import FormContacto from '../components/FormContacto.astro'
import Footer from '../components/Footer.astro'
import WhatsAppFloat from '../components/WhatsAppFloat.astro'
import OtrasAventuras from '../components/OtrasAventuras.astro'
---

<Layout
  title="Cuatrimotos en Útica – Rutas 4x4 todo terreno | Horse Payo"
  description="Cuatrimotos en Útica, Cundinamarca. Recorre senderos de montaña en 4x4 con rutas para todos los niveles. A solo 2 horas de Bogotá. Desde $93.000 por persona."
  canonical="https://deportesextremoshorsepayo.com/cuatrimotos-utica/"
  ogImage="https://deportesextremoshorsepayo.com/plan-cuatrimoto.jpg"
>
  <Navbar />
  <Breadcrumbs items={[{ label: 'Cuatrimotos' }]} />

  <main>
    <!-- Hero -->
    <section class="relative h-[70vh] min-h-[500px] flex items-center overflow-hidden">
      <div class="absolute inset-0 z-0">
        <video src="/CuatrimotosVideo.mp4" poster="/CuatrimotosBanner.jpeg" autoplay muted loop playsinline class="w-full h-full object-cover object-center" aria-label="Cuatrimotos en Útica, Cundinamarca"></video>
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-transparent"></div>
      </div>
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full pt-20">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 bg-accent/90 text-primary-dark text-sm font-bold px-4 py-2 rounded-full mb-6">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
            Útica, Cundinamarca
          </div>
          <h1 class="text-white font-heading font-black text-5xl sm:text-6xl lg:text-7xl leading-tight mb-6">
            Cuatrimotos en <span class="text-accent">Útica</span>
          </h1>
          <p class="text-white/80 text-lg sm:text-xl font-body max-w-xl mb-8">
            Recorre senderos de montaña en cuatrimoto 4x4 con rutas para todos los niveles. Adrenalina pura sobre ruedas a solo 2 horas de Bogotá.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="https://wa.me/573228837910?text=Hola!%20Quiero%20reservar%20cuatrimotos%20en%20%C3%9Atica%20con%20Horse%20Payo" target="_blank" rel="noopener noreferrer" onclick="fbq('track', 'Lead', {content_name: 'Cuatrimotos Hero', currency: 'COP'}); dataLayer.push({event:'cta_click',plan:'cuatrimotos'})" class="bg-accent text-primary-dark font-bold px-8 py-4 rounded-full hover:bg-accent-dark transition-all duration-300 hover:scale-105 shadow-xl text-base inline-flex items-center gap-3">
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/></svg>
              Reservar Cuatrimotos Ahora
            </a>
            <a href="#info-cuatrimotos" onclick="fbq('track', 'ViewContent', {content_name: 'Info Cuatrimotos', content_category: 'navigation'})" class="border-2 border-white text-white font-semibold px-8 py-4 rounded-full hover:bg-white hover:text-primary-dark transition-all duration-300 inline-flex items-center gap-2">
              Más información
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Info section -->
    <section id="info-cuatrimotos" class="py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <span class="section-tag reveal">CUATRIMOTOS</span>
            <h2 class="font-heading font-black text-4xl sm:text-5xl text-primary-dark mt-4 mb-6 leading-tight reveal reveal-delay-1">
              Domina la montaña con nuestras <span class="text-primary">cuatrimotos 4x4</span>
            </h2>
            <div class="space-y-4 text-gray-600 font-body leading-relaxed reveal reveal-delay-2">
              <p>
                Nuestras rutas en cuatrimoto te llevan por senderos de montaña con terrenos variados: subidas empinadas, cruces de ríos y vistas panorámicas del valle. Una experiencia llena de adrenalina apta para mayores de 16 años.
              </p>
              <p>
                Contamos con <strong>cuatrimotos automáticas 4x4</strong> de última generación, fáciles de manejar incluso para principiantes. Antes de cada salida, recibirás una inducción completa y equipo de protección (casco, guantes, gafas).
              </p>
              <p>
                Las cuatrimotos están incluidas en nuestros <strong>Planes Pasadía 4 y 6</strong>, combinables con canopy, torrentismo y cabalgata.
              </p>
            </div>
            <div class="flex flex-wrap gap-3 mt-8 reveal reveal-delay-3">
              <span class="badge-activity"><svg class="w-3 h-3 text-primary" fill="currentColor" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> Cuatrimotos 4x4</span>
              <span class="badge-activity"><svg class="w-3 h-3 text-primary" fill="currentColor" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> Inducción incluida</span>
              <span class="badge-activity"><svg class="w-3 h-3 text-primary" fill="currentColor" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> Equipo completo</span>
              <span class="badge-activity"><svg class="w-3 h-3 text-primary" fill="currentColor" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg> Rutas guiadas</span>
            </div>
          </div>
          <div class="reveal reveal-delay-2">
            <div class="rounded-3xl overflow-hidden shadow-2xl">
              <video src="/CuatrimotosVideo.mp4" poster="/CuatrimotosBanner.jpeg" autoplay muted loop playsinline class="w-full h-[500px] object-cover object-center" aria-label="Cuatrimotos 4x4 en Útica, Cundinamarca"></video>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Galería Cuatrimotos -->
    <section class="py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <span class="section-tag reveal">📸 GALERÍA</span>
          <h2 class="font-heading font-black text-4xl sm:text-5xl text-primary-dark mt-4 mb-4 reveal reveal-delay-1">
            Cuatrimotos en <span class="text-primary">acción</span>
          </h2>
          <p class="text-gray-500 max-w-xl mx-auto font-body reveal reveal-delay-1">
            Aventura 4x4 por los senderos de Útica
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="rounded-2xl overflow-hidden shadow-lg reveal">
            <img src="/Cuatrimotos-galeria-1.jpeg" alt="Grupo en cuatrimotos 4x4 recorriendo sendero de montaña en Útica, Cundinamarca" class="w-full h-64 object-cover hover:scale-105 transition-transform duration-500" loading="lazy" />
          </div>
          <div class="rounded-2xl overflow-hidden shadow-lg reveal reveal-delay-1">
            <img src="/Cuatrimotos-galeria-2.jpeg" alt="Cuatrimoto automática todo terreno en ruta de aventura por la montaña de Útica" class="w-full h-64 object-cover hover:scale-105 transition-transform duration-500" loading="lazy" />
          </div>
          <div class="rounded-2xl overflow-hidden shadow-lg reveal reveal-delay-2">
            <img src="/Cuatrimotos-galeria-3.jpeg" alt="Vista panorámica del valle durante recorrido en cuatrimoto en Útica" class="w-full h-64 object-cover hover:scale-105 transition-transform duration-500" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <!-- Plans that include cuatrimotos -->
    <section id="planes" class="py-24 bg-forest-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-14">
          <h2 class="font-heading font-black text-4xl sm:text-5xl text-primary-dark mb-4 reveal">
            Planes con Cuatrimotos incluidas 🏍️
          </h2>
          <p class="text-gray-500 max-w-xl mx-auto font-body reveal reveal-delay-1">
            Las cuatrimotos 4x4 están disponibles en varios de nuestros planes. Todos incluyen equipo, inducción y guía.
          </p>
        </div>
        <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
          <div class="bg-white rounded-2xl p-6 shadow-lg border border-gray-100 reveal">
            <div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-4">
              <span class="font-display text-3xl text-primary">2</span>
            </div>
            <h3 class="font-heading font-bold text-xl text-primary-dark mb-2">Plan Pasadía 2 🏍️</h3>
            <p class="text-gray-500 text-sm mb-4">Cuatrimoto + Cabalgata + Circuito</p>
            <p class="text-3xl font-black text-primary-dark mb-4">$230.000 <span class="text-base font-normal text-gray-400">/ persona</span></p>
            <ul class="space-y-2 mb-6 text-sm text-gray-600">
              <li class="flex items-center gap-2">🏍️ Cuatrimoto Todo Terreno</li>
              <li class="flex items-center gap-2">🐴 Cabalgata Ecológica Guiada</li>
              <li class="flex items-center gap-2">🧗‍♂️ Circuito Extremo (Canopy, Puentes, Rapel al Vacío)</li>
              <li class="flex items-center gap-2">🍲 Almuerzo Tradicional Incluido</li>
              <li class="flex items-center gap-2">🎟️ Ingreso a las instalaciones y piscina</li>
            </ul>
            <a href="https://wa.me/573228837910?text=Hola!%20Quiero%20reservar%20el%20Plan%20Pasad%C3%ADa%202%20(Cuatrimoto%20%2B%20Cabalgata%20%2B%20Circuito)%20en%20Horse%20Payo" target="_blank" rel="noopener noreferrer" onclick="fbq('track', 'Lead', {content_name: 'Cuatrimotos Pasadía 2', content_ids: ['pasadia_2'], value: 230000, currency: 'COP'})" class="w-full bg-primary-dark text-white font-bold py-3 rounded-xl hover:bg-primary transition-all duration-300 inline-flex items-center justify-center gap-2">
              ⚡ Reservar Plan
            </a>
          </div>
          <div class="bg-white rounded-2xl p-6 shadow-lg border border-gray-100 reveal reveal-delay-1">
            <div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center mb-4">
              <span class="font-display text-3xl text-primary">4</span>
            </div>
            <h3 class="font-heading font-bold text-xl text-primary-dark mb-2">Plan Pasadía 4 🌊</h3>
            <p class="text-gray-500 text-sm mb-4">Cuatrimoto + Rafting + Cabalgata</p>
            <p class="text-3xl font-black text-primary-dark mb-4">$290.000 <span class="text-base font-normal text-gray-400">/ persona</span></p>
            <ul class="space-y-2 mb-6 text-sm text-gray-600">
              <li class="flex items-center gap-2">🏍️ Cuatrimoto Todo Terreno</li>
              <li class="flex items-center gap-2">🌊 Rafting Extremo (Balsa + Minitren)</li>
              <li class="flex items-center gap-2">🐴 Cabalgata Ecológica Guiada</li>
              <li class="flex items-center gap-2">🍲 Almuerzo Tradicional Incluido</li>
              <li class="flex items-center gap-2">🎟️ Ingreso a las instalaciones y piscina</li>
            </ul>
            <a href="https://wa.me/573228837910?text=Hola!%20Quiero%20reservar%20el%20Plan%20Pasad%C3%ADa%204%20(Cuatrimoto%20%2B%20Rafting%20%2B%20Cabalgata)%20en%20Horse%20Payo" target="_blank" rel="noopener noreferrer" onclick="fbq('track', 'Lead', {content_name: 'Cuatrimotos Pasadía 4', content_ids: ['pasadia_4'], value: 290000, currency: 'COP'})" class="w-full bg-primary-dark text-white font-bold py-3 rounded-xl hover:bg-primary transition-all duration-300 inline-flex items-center justify-center gap-2">
              ⚡ Reservar Plan
            </a>
          </div>
          <div class="bg-white rounded-2xl p-6 shadow-lg ring-2 ring-accent reveal reveal-delay-2">
            <div class="w-14 h-14 bg-accent/20 rounded-xl flex items-center justify-center mb-4">
              <span class="font-display text-3xl text-accent-dark">5</span>
            </div>
            <span class="bg-accent text-primary-dark text-xs font-black px-3 py-1 rounded-full tracking-wide mb-3 inline-block">🏆 MÁS COMPLETO</span>
            <h3 class="font-heading font-bold text-xl text-primary-dark mb-2">Plan Pasadía 5 🏆</h3>
            <p class="text-gray-500 text-sm mb-4">Aventura Total</p>
            <p class="text-3xl font-black text-primary-dark mb-4">$350.000 <span class="text-base font-normal text-gray-400">/ persona</span></p>
            <ul class="space-y-2 mb-6 text-sm text-gray-600">
              <li class="flex items-center gap-2">🏍️ Cuatrimoto Todo Terreno</li>
              <li class="flex items-center gap-2">🐴 Cabalgata Ecológica Guiada</li>
              <li class="flex items-center gap-2">🌊 Rafting Extremo (Balsa + Minitren)</li>
              <li class="flex items-center gap-2">🧗‍♂️ Circuito Extremo (Canopy, Puentes, Rapel al Vacío)</li>
              <li class="flex items-center gap-2">🍲 Almuerzo Tradicional Incluido</li>
              <li class="flex items-center gap-2">🎟️ Ingreso a las instalaciones y piscina</li>
            </ul>
            <a href="https://wa.me/573228837910?text=Hola!%20Quiero%20reservar%20el%20Plan%20Pasad%C3%ADa%205%20(Aventura%20Total)%20en%20Horse%20Payo" target="_blank" rel="noopener noreferrer" onclick="fbq('track', 'Lead', {content_name: 'Cuatrimotos Pasadía 5', content_ids: ['pasadia_5'], value: 350000, currency: 'COP'})" class="w-full bg-accent text-primary-dark font-bold py-3 rounded-xl hover:bg-accent-dark transition-all duration-300 inline-flex items-center justify-center gap-2">
              📲 Reservar Ahora
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20 bg-accent relative overflow-hidden">
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute -top-16 -right-16 w-72 h-72 rounded-full bg-accent-light/40"></div>
        <div class="absolute -bottom-20 -left-20 w-96 h-96 rounded-full bg-accent-dark/20"></div>
      </div>
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center relative z-10">
        <h2 class="font-heading font-black text-4xl sm:text-5xl lg:text-6xl text-primary-dark mb-4 reveal">
          ¿Listo para la montaña?
        </h2>
        <p class="text-primary-dark/70 text-lg font-body max-w-xl mx-auto mb-10 reveal reveal-delay-1">
          Reserva tus cuatrimotos hoy y domina los senderos de Útica.
        </p>
        <a href="https://wa.me/573228837910?text=Hola!%20Quiero%20reservar%20cuatrimotos%20en%20%C3%9Atica%20con%20Horse%20Payo" target="_blank" rel="noopener noreferrer" onclick="fbq('track', 'Lead', {content_name: 'Cuatrimotos CTA Final', currency: 'COP'})" class="bg-primary-dark text-white font-bold px-10 py-4 rounded-full inline-flex items-center gap-3 hover:bg-primary transition-all duration-300 hover:scale-105 shadow-xl text-lg reveal reveal-delay-2">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/></svg>
          Reservar Cuatrimotos
        </a>
      </div>
    </section>

    <FormContacto />

    <OtrasAventuras excludeHref="/cuatrimotos-utica/" />

    <!-- Product + FAQ Schema -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Product",
          "name": "Cuatrimotos 4x4 en Útica – Horse Payo",
          "description": "Rutas en cuatrimoto automática 4x4 por senderos de montaña en Útica, Cundinamarca. Inducción completa, equipo de protección (casco, guantes, gafas) y guías expertos. Apto para mayores de 16 años. A solo 2 horas de Bogotá.",
          "brand": {
            "@type": "Brand",
            "name": "Horse Payo"
          },
          "offers": {
            "@type": "Offer",
            "price": "230000",
            "priceCurrency": "COP",
            "availability": "https://schema.org/InStock",
            "url": "https://deportesextremoshorsepayo.com/cuatrimotos-utica/"
          },
          "image": "https://deportesextremoshorsepayo.com/plan-cuatrimoto.jpg"
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "¿Cuánto cuesta la cuatrimoto en Útica?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "El Pasadía 2 (Cuatrimoto + Cabalgata + Circuito) tiene un valor de $230.000 por persona. Incluye inducción, equipo de protección, guías, almuerzo y parqueadero."
              }
            },
            {
              "@type": "Question",
              "name": "¿Necesito experiencia previa para manejar cuatrimoto?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "No. Nuestras cuatrimotos son automáticas 4x4, fáciles de manejar incluso para principiantes. Antes de cada salida recibirás inducción completa y todo el equipo de seguridad necesario."
              }
            },
            {
              "@type": "Question",
              "name": "¿Cuál es la edad mínima para andar en cuatrimoto?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "La edad mínima para conducir cuatrimoto en Horse Payo es 16 años. Los menores pueden ir como acompañantes en algunas rutas, previa consulta."
              }
            },
            {
              "@type": "Question",
              "name": "¿Qué incluye la experiencia en cuatrimoto?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Ruta en cuatrimoto 4x4 por senderos de montaña, inducción, casco, guantes, gafas, guía experto, almuerzo tradicional, ingreso a piscina y parqueadero vigilado."
              }
            }
          ]
        }
      ]
    }
    </script>
  </main>

  <Footer />
  <WhatsAppFloat />
</Layout>
