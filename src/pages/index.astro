---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Plans from '../components/Plans.astro';
import Activities from '../components/Activities.astro';
import Testimonials from '../components/Testimonials.astro';
import Location from '../components/Location.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
---

<Layout
  title="Horse Payo – Aventura y Ecoturismo en Útica, Cundinamarca"
  description="Vive la aventura extrema. Canopy, rafting, cabalgata ecológica, cuatrimotos y torrentismo. A solo 2 horas de Bogotá. Desde $93.000 por persona."
>
  <!-- Fixed navigation -->
  <Navbar />

  <!-- Page sections -->
  <main>
    <Hero />
    <About />
    <Plans />
    <Activities />
    <Testimonials />
    <Location />
    <CTA />
  </main>

  <!-- Footer -->
  <Footer />

  <!-- Floating WhatsApp button -->
  <WhatsAppFloat />
</Layout>
