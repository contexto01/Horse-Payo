---
import '../styles/global.css'

export interface Props {
  title?: string
  description?: string
  canonical?: string
  ogImage?: string
}

const {
  title = 'Horse Payo – Aventura y Ecoturismo en Útica, Cundinamarca',
  description = 'Vive la aventura extrema en Útica, Cundinamarca. Canopy, rafting, cabalgata ecológica, cuatrimotos y torrentismo en el corazón de la naturaleza colombiana. A solo 2 horas de Bogotá. Canopy individual desde $93.000 y planes completos desde $190.000.',
  canonical = 'https://deportesextremoshorsepayo.com/',
  ogImage = 'https://deportesextremoshorsepayo.com/hero.jpg'
} = Astro.props

const siteName = 'Horse Payo'
const siteUrl = 'https://deportesextremoshorsepayo.com'
